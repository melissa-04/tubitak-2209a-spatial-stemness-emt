        "    \"PLOD2\",\"GALNT2\",\"LEPREL1\",\"MAGED1\",\"SLC38A5\",\"FSTL3\",\"CD99\",\"F3\",\"PSAP\",\"NMRK1\",\n",
        "    \"FKBP9\",\"DSG2\",\"ECM1\",\"HTRA1\",\"SERINC1\",\"CALU\",\"TPST1\",\"PLOD3\",\"IGFBP3\",\"FRMD6\",\n",
        "    \"CXCL14\",\"SERPINE2\",\"RABAC1\",\"TMED9\",\"NAGK\",\"BMP1\",\"ESYT1\",\"STON2\",\"TAGLN\",\"GJA1\",\n",
        "]\n",
        "\n",
        "# 2017 sembollerini güncel HGNC adlarına eşle (veride eski/yeni hangisi varsa onu kullan)\n",
        "alias = {\"PRKCDBP\":\"CAVIN3\", \"CXCR7\":\"ACKR3\", \"DFNA5\":\"GSDME\", \"LEPREL1\":\"P3H2\"}\n",
        "\n",
        "def resolve(genes, var_names):\n",
        "    vset = set(var_names); found = []; missing = []\n",
        "    for g in genes:\n",
        "        if g in vset: found.append(g)\n",
        "        elif g in alias and alias[g] in vset: found.append(alias[g])\n",
        "        else: missing.append(g)\n",
        "    return found, missing\n",
        "\n",
        "pemt_found, pemt_missing = resolve(pemt_puram, adata.var_names)\n",
        "print(f\"Puram pEMT: {len(pemt_found)}/{len(pemt_puram)} gen eşleşti\")\n",
        "if pemt_missing: print(\"Eşleşmeyen:\", pemt_missing)\n",
        "\n",
        "sc.tl.score_genes(adata, gene_list=pemt_found, score_name=\"pEMT_puram\",\n",
        "                  ctrl_size=50, random_state=42, use_raw=False)\n",
        "print(\"\\npEMT_puram özeti:\"); print(adata.obs[\"pEMT_puram\"].describe())"
