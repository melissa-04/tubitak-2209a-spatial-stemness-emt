        "# Hücre 12 — AŞAMA 6.2: DAİRESELLİK KONTROLÜ (kısmi korelasyon)\n",
        "# Soru: tümör içeriğini (Cancer Epithelial oranı) sabitleyince\n",
        "# stemness × EMT korelasyonu hâlâ pozitif kalıyor mu?\n",
        "from scipy.stats import spearmanr\n",
        "\n",
        "def partial_spearman(d, x, y, z):\n",
        "    # x,y'yi z üzerine sıra-regresyonuyla artıkla, artıkların korelasyonu\n",
        "    from scipy.stats import rankdata\n",
        "    import numpy as np\n",
        "    xr, yr, zr = rankdata(d[x]), rankdata(d[y]), rankdata(d[z])\n",
        "    # z'ye göre doğrusal artık\n",
        "    def resid(a, b):\n",
        "        b = np.c_[np.ones_like(b), b]\n",
        "        beta = np.linalg.lstsq(b, a, rcond=None)[0]\n",
        "        return a - b @ beta\n",
        "    rx, ry = resid(xr, zr), resid(yr, zr)\n",
        "    r, pv = spearmanr(rx, ry)\n",
        "    return r, pv\n",
        "\n",
        "df = allsc[allsc[\"spatial_stemness\"].notna()].copy()\n",
        "patients = sorted(df[\"patientid\"].unique())\n",
        "\n",
        "for s in [\"pEMT_puram\",\"EMT_hallmark\",\"EMT_tan\"]:\n",
        "    print(f\"\\n{s}: ham r  →  kısmi r (Cancer Epithelial sabit)\")\n",
        "    raw_rs, par_rs = [], []\n",
        "    for p in patients:\n",
        "        sub = df[df.patientid==p]\n",
        "        raw = spearmanr(sub.spatial_stemness, sub[s])[0]\n",
        "        par = partial_spearman(sub, \"spatial_stemness\", s, \"Cancer Epithelial\")[0]\n",
        "        raw_rs.append(raw); par_rs.append(par)\n",
        "        print(f\"  {p:<10} {raw:+.3f}  →  {par:+.3f}\")\n",
        "    print(f\"  medyan:    {np.median(raw_rs):+.3f}  →  {np.median(par_rs):+.3f}\"\n",
        "          f\"   | kısmi pozitif: {sum(r>0 for r in par_rs)}/6\")"
